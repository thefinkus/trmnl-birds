{% comment %} Bird of the Day, half vertical: the quiet picture in its portrait version, fitted into the cell. {% endcomment %}
<div class="layout p--0">
  <img class="image image-dither image--contain w--full h--full hidden lg:block" src="{{ images_portrait.quiet | default: image_url }}" alt="{{ name }}">
  <img class="image image-dither image--contain w--full h--full lg:hidden" src="{{ images_og_portrait.quiet | default: image_url }}" alt="{{ name }}">
</div>
