{% comment %} Bird of the Day, quadrant: the quiet picture, fitted into the cell. {% endcomment %}
<div class="layout p--0">
  <img class="image image-dither image--contain w--full h--full hidden lg:block" src="{{ images.quiet | default: image_url }}" alt="{{ name }}">
